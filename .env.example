# ==============================================
# RingGuard AI - Environment Configuration Example
# Stage 3: PostgreSQL Database
# (No secrets / No real credentials committed)
# ==============================================

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Connection
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:6207/ringguard

# Frontend Configuration (Public API Target)
NEXT_PUBLIC_API_URL=http://localhost:8000
